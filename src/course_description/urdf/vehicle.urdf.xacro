<?xml version="1.0"?>
<robot name="course_ackermann" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="wheelbase" default="0.80"/>
  <xacro:arg name="track_width" default="0.62"/>
  <xacro:arg name="wheel_radius" default="0.12"/>
  <xacro:property name="wheelbase" value="$(arg wheelbase)"/>
  <xacro:property name="track_width" value="$(arg track_width)"/>
  <xacro:property name="wheel_radius" value="$(arg wheel_radius)"/>
  <xacro:property name="wheel_width" value="0.07"/>
  <xacro:property name="body_size" value="1.05 0.52 0.22"/>
  <xacro:property name="body_center" value="0 0 0.12"/>
  <xacro:property name="sensor_mount" value="0.28 0 0.38"/>

  <material name="body_blue"><color rgba="0.05 0.36 0.72 1"/></material>
  <material name="tire_black"><color rgba="0.04 0.04 0.04 1"/></material>

  <link name="base_link">
    <visual>
      <origin xyz="${body_center}"/>
      <geometry><box size="${body_size}"/></geometry>
      <material name="body_blue"/>
    </visual>
    <collision>
      <origin xyz="${body_center}"/>
      <geometry><box size="${body_size}"/></geometry>
    </collision>
    <inertial>
      <origin xyz="${body_center}"/>
      <mass value="12.0"/>
      <inertia ixx="0.55" ixy="0" ixz="0" iyy="1.10" iyz="0" izz="1.40"/>
    </inertial>
  </link>

  <link name="lidar_link"/>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="${sensor_mount}" rpy="0 0 0"/>
  </joint>

  <link name="camera_link"/>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="${sensor_mount}" rpy="0 0 0"/>
  </joint>
  <link name="camera_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="${-pi / 2} 0 ${-pi / 2}"/>
  </joint>

  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="${sensor_mount}" rpy="0 0 0"/>
  </joint>

  <xacro:macro name="steering" params="side y">
    <link name="front_${side}_knuckle">
      <inertial>
        <mass value="0.2"/>
        <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
      </inertial>
    </link>
    <joint name="front_${side}_steering_joint" type="revolute">
      <parent link="base_link"/>
      <child link="front_${side}_knuckle"/>
      <origin xyz="${wheelbase / 2} ${y} 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="-0.55" upper="0.55" effort="25" velocity="2"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="wheel" params="name parent x y">
    <link name="${name}_wheel">
      <visual>
        <origin rpy="${pi / 2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="tire_black"/>
      </visual>
      <collision>
        <origin rpy="${pi / 2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <inertial>
        <mass value="0.8"/>
        <inertia ixx="0.006" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.006"/>
      </inertial>
    </link>
    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="${parent}"/>
      <child link="${name}_wheel"/>
      <origin xyz="${x} ${y} 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:steering side="left" y="${track_width / 2}"/>
  <xacro:steering side="right" y="${-track_width / 2}"/>
  <xacro:wheel name="front_left" parent="front_left_knuckle" x="0" y="0"/>
  <xacro:wheel name="front_right" parent="front_right_knuckle" x="0" y="0"/>
  <xacro:wheel name="rear_left" parent="base_link" x="${-wheelbase / 2}" y="${track_width / 2}"/>
  <xacro:wheel name="rear_right" parent="base_link" x="${-wheelbase / 2}" y="${-track_width / 2}"/>
</robot>
